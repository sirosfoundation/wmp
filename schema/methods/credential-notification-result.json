{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leifj/wmp/schema/methods/credential-notification-result.json",
  "title": "credential_notification flow \u2014 result and error data",
  "description": "#/$defs/result is the result member of the wmp.flow.complete of a credential_notification flow, #/$defs/errorData the data of its -31006 wmp.flow.error (WMP OpenID4x 3.4.2). Select the definition by the message method.",
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "status",
        "notification_id"
      ],
      "properties": {
        "status": {
          "const": "forwarded"
        },
        "notification_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "errorData": {
      "type": "object",
      "required": [
        "reason",
        "retryable"
      ],
      "properties": {
        "reason": {
          "enum": [
            "context_unavailable",
            "busy",
            "signing_failed",
            "forward_failed"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "busy"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
