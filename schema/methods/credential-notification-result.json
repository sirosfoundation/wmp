{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leifj/wmp/schema/methods/credential-notification-result.json",
  "title": "credential_notification flow — result and error data",
  "description": "The result member of the wmp.flow.complete of a credential_notification flow, and the data of its wmp.flow.error (WMP OpenID4x 3.4.2).",
  "oneOf": [
    {
      "title": "result",
      "type": "object",
      "required": ["status", "notification_id"],
      "properties": {
        "status": { "const": "forwarded" },
        "notification_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    {
      "title": "error data",
      "type": "object",
      "required": ["reason", "retryable"],
      "properties": {
        "reason": { "enum": ["context_unavailable", "busy", "signing_failed", "forward_failed"] },
        "retryable": { "type": "boolean" }
      }
    }
  ]
}
