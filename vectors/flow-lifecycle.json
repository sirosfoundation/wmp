          "nonce": "bUtJdjJESWdmTWNjb011YQ",
          "audience": "x509_san_dns:shop.example.com",
          "parent_flow_id": "flow-vp-001",
          "response_mode": "direct_post.jwt",
          "response_encryption": {
            "jwk": {
