              "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0",
              "kid": "verifier-enc-1",
              "use": "enc"
            },
            "alg": "ECDH-ES",
            "enc": "A128GCM"
          },
          "state": "st-1",
          "verifier_jwk_thumbprint": "oKIywvGUpTVTyxMQ3bwIIeQUudfr_CkLMjCE19ECD-U",
          "verified_request": {
            "client_id": "x509_san_dns:shop.example.com",
            "client_id_scheme": "x509_san_dns",
