        "result": {
          "credentials": [
            {
              "format": "vc+sd-jwt",
              "credential": "eyJ0ZXN0"
            }
          ],
          "redacted_members": [
            "dpop_key_id",
            "refresh_token"
          ]
        }
      }
    },
    "expected_response": null,
    "notes": "Only the members that were present are listed. The client must not invent a refresh_token; the credential cannot be renewed without re-issuance."
  },
  {
    "id": "flow-sign-generate-proof-response-encryption",
    "description": "Sign flow requesting a key proof together with a client-held credential-response encryption key (proof_type and proof_types_supported present: proofs are requested).",
    "conformance_level": "flows",
    "input": {
      "jsonrpc": "2.0",
      "id": "flow-vci-001-sign-req",
      "method": "wmp.flow.start",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "did:web:issuer.example.com"
        },
        "flow_type": "sign",
        "flow_id": "flow-vci-001-sign",
        "params": {
          "action": "generate_proof",
          "parent_flow_id": "flow-vci-001",
          "nonce": "n-0S6_WzA2Mj",
          "audience": "https://issuer.example.com",
          "count": 1,
          "credential_response_encryption": {
            "alg": "ECDH-ES",
            "enc": "A256GCM",
            "required": true
          },
          "proof_type": "jwt",
          "proof_types_supported": {
            "jwt": {
              "proof_signing_alg_values_supported": [
                "ES256"
              ]
            }
          }
        }
      }
    },
    "notes": "credential_response_encryption is additive and ignorable. The client generates a fresh ephemeral P-256 key, keeps the private key and returns the public JWK as credential_response_encryption_jwk in the sign result; absent or empty means declined, which fails the issuance when required is true."
  },
  {
    "id": "flow-sign-result-credential-response-key",
    "description": "Sign result of generate_proof carrying the client's public response-encryption JWK.",
    "conformance_level": "flows",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.flow.complete",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "flow_id": "flow-vci-001-sign",
        "result": {
          "proof_jwt": "eyJ0ZXN0",
          "credential_response_encryption_jwk": {
            "kty": "EC",
            "crv": "P-256",
            "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
            "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0",
            "use": "enc",
            "alg": "ECDH-ES"
          }
        }
      }
    },
    "expected_response": null,
    "notes": "Public coordinates only; the private key never leaves the client."
  },
