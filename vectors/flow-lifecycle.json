    "id": "flow-sign-rejected",
    "description": "A wallet declines the sign sub-flow: -31006 with data.reason rejected.",
    "conformance_level": "flows",
    "input": [
      {
        "step": "orchestrator starts the sign sub-flow",
        "message": {
          "jsonrpc": "2.0",
          "id": "sign-rej-001",
          "method": "wmp.flow.start",
          "params": {
            "wmp": {
              "version": "0.1",
              "session_id": "ses-a1b2c3d4",
              "sender": "x509:san:dns:orchestrator.example.com"
            },
            "flow_type": "sign",
            "flow_id": "flow-vp-001-sign",
            "params": {
              "parent_flow_id": "flow-vp-001",
              "action": "sign_presentation",
              "nonce": "n-1",
              "audience": "https://verifier.example.com"
            }
          }
        }
      },
      {
        "step": "wallet declines",
        "message": {
          "jsonrpc": "2.0",
          "method": "wmp.flow.error",
          "params": {
            "wmp": {
              "version": "0.1",
              "session_id": "ses-a1b2c3d4"
            },
            "flow_id": "flow-vp-001-sign",
            "code": -31006,
            "message": "declined",
            "data": {
              "reason": "rejected"
            }
          }
        }
      },
      {
        "step": "orchestrator ends the parent flow at once, without waiting for the sub-flow timeout",
        "message": {
          "jsonrpc": "2.0",
          "method": "wmp.flow.error",
          "params": {
            "wmp": {
              "version": "0.1",
              "session_id": "ses-a1b2c3d4"
            },
            "flow_id": "flow-vp-001",
            "code": -31006,
            "message": "User declined the request",
            "data": {
              "redirect_uri": "https://verifier.example.com/cb?error=access_denied&state=st-1"
            }
          }
        }
      }
    ],
    "notes": "openid4x Section 3.2.6. The verifier is told access_denied with the request's state and no error_description; message and other data of the sub-flow error are not forwarded."
  },
