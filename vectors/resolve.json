[
  {
    "id": "resolve-vctm",
    "description": "Resolve VCTM metadata for a credential type URI.",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "id": "res-001",
      "method": "wmp.resolve",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": "https://credentials.example.com/identity"
      }
    },
    "expected_response": {
      "jsonrpc": "2.0",
      "id": "res-001",
      "result": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": "https://credentials.example.com/identity",
        "metadata": {
          "vct": "https://credentials.example.com/identity",
          "name": "National ID Card",
          "description": "Government-issued identity credential",
          "display": [
            { "lang": "en", "name": "National ID", "description": "Government-issued identity credential" }
          ],
          "claims": [
            { "path": ["given_name"], "display": [{ "lang": "en", "name": "First name" }] },
            { "path": ["family_name"], "display": [{ "lang": "en", "name": "Last name" }] }
          ]
        },
        "trust_info": {
          "trusted": true,
          "source": "registry"
        }
      }
    }
  },
  {
    "id": "resolve-not-found",
    "description": "Resolve returns null metadata when the orchestrator knows the URI is unknown (one that cannot tell unknown from unreachable answers as in resolve-fetch-failed).",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "id": "res-002",
      "method": "wmp.resolve",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": "https://unknown.example.com/nonexistent"
      }
    },
    "expected_response": {
      "jsonrpc": "2.0",
      "id": "res-002",
      "result": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": "https://unknown.example.com/nonexistent",
        "metadata": null
      }
    }
  },
  {
    "id": "resolve-fetch-failed",
    "description": "A vctm lookup that finds no document, cannot reach one or finds one that is not a JSON object is an error, not null (WMP Core 5.8.1).",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "id": "res-004",
      "method": "wmp.resolve",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": "https://unreachable.example.com/vct"
      }
    },
    "expected_error": {
      "jsonrpc": "2.0",
      "id": "res-004",
      "error": { "code": -32603, "message": "Internal error", "data": { "reason": "metadata_fetch_error" } }
    }
  },
  {
    "id": "resolve-empty-uri",
    "description": "A vctm resolve with an empty uri is invalid params.",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "id": "res-005",
      "method": "wmp.resolve",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "vctm",
        "uri": ""
      }
    },
    "expected_error": {
      "jsonrpc": "2.0",
      "id": "res-005",
      "error": { "code": -32602, "message": "Invalid params" }
    }
  },
  {
    "id": "resolve-unsupported-type",
    "description": "Resolve returns error for unsupported resolution type.",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "id": "res-003",
      "method": "wmp.resolve",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4"
        },
        "type": "smp",
        "uri": "ebcore:iso6523:0088:1234567890"
      }
    },
    "expected_error": {
      "jsonrpc": "2.0",
      "id": "res-003",
      "error": {
        "code": -31005,
        "message": "Resolution type not supported",
        "data": { "unsupported": "smp", "type": "smp" }
      }
    }
  }
]
